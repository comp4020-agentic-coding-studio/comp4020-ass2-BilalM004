---
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import heroImage from "../assets/images/hero-home.jpg";
import { courseMeta } from "../course-config";
import { sessionLabels, siteConfig } from "../site-config";
---

<ContentLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  heroImage={heroImage}
  heroImageAlt="An illustrated campus corridor: students cluster in conversation past lockers and lecture-hall doors, while near the entrance two students staff a pop-up stall labelled HALLWAY ECONOMICS, handing a zine to a passer-by"
  {...siteConfig}
>
  <ul class="course-tags" aria-label="Course tags">
    {courseMeta.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <h2>What you will do</h2>
  <p>
    Twelve weeks, twelve trips into the hallway. You start conversations with
    people you don't know, run a pop-up stall to see who stops, ask a
    stranger for something you might be refused, and notice the small
    opportunities already sitting around campus — then bring back what
    happened to a room full of people who did the same thing differently.
    You leave with a logbook of real interactions, not a grade for staying
    quiet in a seminar.
  </p>

  <h2>Who it is for</h2>
  <p>
    Anyone who can tolerate being told no and wants practice doing it more
    often. No portfolio, no pitch deck, no prior networking experience —
    just a willingness to walk up to someone and start something. If the
    idea of setting up a stall in the busiest foyer on campus makes you
    wince a little, that's the reaction the course is built around.
  </p>

  <h2>Where to go next</h2>
  <CardGrid columns={2}>
    <Card title={sessionLabels.plural} href="/sessions/">
      <p>The weekly fieldwork brief: what you do out in the hallway, and how you report it back.</p>
    </Card>
    <Card title="Assessment" href="/assessments/">
      <p>What is marked, what it is worth, and when it is due.</p>
    </Card>
    <Card title="People" href="/people/">
      <p>Who teaches the course and how to reach them.</p>
    </Card>
  </CardGrid>
</ContentLayout>

<style>
  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0 2rem;
    padding: 0;
    list-style: none;
  }

  .course-tags li {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    color: var(--at-text-secondary);
    background: var(--at-bg-alt);
    font-size: 0.9rem;
  }
</style>
