---
// The twelve-week shape, as one figure: six Crossings, each two weeks, an
// outlined "out" week paired with a filled "back" week --- and the sixth
// pair broken, because Crossing 6 has no fieldwork. Drawn rather than
// sourced so it matches the brand exactly and stays sharp at projection
// size. Colours come from the --at-* tokens the deck already uses.
const pairs = [1, 2, 3, 4, 5, 6];
const PAIR = 170;
---

<svg
  class="fig fig-crossing"
  viewBox="0 0 1000 190"
  role="img"
  aria-label="Twelve weeks as six Crossings. Crossings 1 to 5 each pair an out week in the hallway with a back week reporting to the room. Crossing 6 has no out week."
>
  {
    pairs.map((n) => {
      const x = (n - 1) * PAIR;
      const last = n === 6;
      return (
        <>
          <rect class={last ? "cell out none" : "cell out"} x={x} y="20" width="70" height="70" rx="6" />
          {last && <line class="strike" x1={x + 20} y1="55" x2={x + 50} y2="55" />}
          <rect class="cell back" x={x + 80} y="20" width="70" height="70" rx="6" />
          <text class="label" x={x + 75} y="118" text-anchor="middle">Crossing {n}</text>
        </>
      );
    })
  }

  <g class="key" transform="translate(0 158)">
    <rect class="cell out" x="0" y="-12" width="22" height="22" rx="4" />
    <text class="label" x="32" y="4">out — in the hallway</text>
    <rect class="cell back" x="230" y="-12" width="22" height="22" rx="4" />
    <text class="label" x="262" y="4">back — reporting to the room</text>
    <text class="label dim" x="540" y="4">Crossing 6 has no hallway week</text>
  </g>
</svg>

<style>
  .fig {
    width: 100%;
    height: auto;
    margin-block: 1.5rem;
    font-family: inherit;
  }

  .cell {
    stroke: var(--at-primary);
    stroke-width: 2.5;
  }

  .out {
    fill: none;
  }

  .out.none {
    stroke-dasharray: 5 5;
    opacity: 0.45;
  }

  .back {
    fill: var(--at-primary);
    stroke: none;
  }

  .strike {
    stroke: var(--at-primary);
    stroke-width: 2.5;
    opacity: 0.45;
  }

  .label {
    fill: var(--at-text-secondary);
    font-size: 17px;
  }

  .dim {
    opacity: 0.7;
  }
</style>
